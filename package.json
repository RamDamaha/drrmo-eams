{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "lint": "eslint .",
        "format": "prettier --write resources/js",
        "format:check": "prettier --check resources/js",
        "typecheck": "tsc",
        "test": "vitest run",
        "check": "npm run lint && npm run format:check && npm run typecheck && npm run test"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tailwindcss/vite": "^4.0.0",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@types/leaflet": "^1.9.22",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.2.1",
        "concurrently": "^10.0.3",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.14.0",
        "jsdom": "^30.1.3",
        "laravel-vite-plugin": "^3.1",
        "prettier": "^3.9.10",
        "tailwindcss": "^4.0.0",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.72.1",
        "vite": "^8.0.0",
        "vitest": "^5.1.0"
    },
    "dependencies": {
        "@tanstack/react-query": "^5.106.1",
        "leaflet": "^1.9.4",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-leaflet": "^5.0.0",
        "react-router": "^7.18.5"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    }
}
